NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_INVENTORY_EXPORT_TOKEN=
# Server-only key with the Geocoding API enabled. Do not expose this value in browser code.
